# Copy to .env.local and fill in real values. All keys are server-side secrets
# except the NEXT_PUBLIC_* pair (which are safe to expose by design).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# Migrations (npm run db:migrate) — set ONE of these; token preferred
SUPABASE_ACCESS_TOKEN=
# DATABASE_URL=

# Later passes (delegation notifications)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
