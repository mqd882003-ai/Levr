# Copy to .env.local and fill in real values. All keys are server-side secrets
# except the NEXT_PUBLIC_* pair (which are safe to expose by design).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# Migrations (npm run db:migrate) — set ONE of these; token preferred
SUPABASE_ACCESS_TOKEN=
# DATABASE_URL=

# Delegation notifications — all server-side secrets
# SMS (Twilio; number must be on a registered A2P campaign)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Email (Resend transactional API; EMAIL_FROM must be a verified sender)
RESEND_API_KEY=
EMAIL_FROM=Levr <notifications@yourdomain.com>
# Slack (optional; incoming webhook of the connected workspace)
SLACK_WEBHOOK_URL=
